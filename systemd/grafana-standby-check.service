[Unit]
Description=Check primary Grafana and control standby alerting
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/grafana_standby.py check
ProtectSystem=strict
ReadWritePaths=/var/lib/grafana-standby /var/lib/prometheus/node-exporter
NoNewPrivileges=true

